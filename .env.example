FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000
FLIGHT_ARCHIVE_PATH=/tmp/live-flights-map-history.sqlite3
FLIGHT_ARCHIVE_RETENTION_HOURS=24
FLIGHT_ARCHIVE_MAX_SNAPSHOTS=720
FLIGHT_SEARCH_LOOKBACK_HOURS=6
FRONTEND_PORT=5174
AIRPORT_CATALOG_URL=https://davidmegginson.github.io/ourairports-data/airports.csv
AIRPORT_CATALOG_CACHE_PATH=/tmp/live-flights-map-airports.csv
AIRPORT_CATALOG_CACHE_TTL=86400
AIRPORT_CATALOG_TIMEOUT=20

# New OpenSky API clients use OAuth2. Leave empty for anonymous access.
FLIGHT_DATA_PROVIDERS=opensky,adsb_lol
# Create an API client at opensky-network.org for higher free quotas.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
SNAPSHOT_COLLECTOR_INTERVAL_SECONDS=
# Legacy accounts only; OAuth2 values above take precedence.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_TIMEOUT=10
OPENSKY_RETRY_COUNT=1
ADSB_LOL_BASE_URL=https://api.adsb.lol
ADSB_LOL_TIMEOUT=10
ADSB_LOL_RETRY_COUNT=1
ADSB_LOL_RADIUS_LIMIT_NM=250
ADSB_LOL_REGION_MIN_INTERVAL_SECONDS=30
OPENSKY_CACHE_TTL=25
OPENSKY_COOLDOWN_SECONDS=75
LIVE_LATEST_CACHE_MAX_AGE_SECONDS=1260
LIVE_LATEST_CACHE_STALE_AFTER_SECONDS=120
SNAPSHOT_COLLECTOR_SECTORS=global_world
FLIGHT_STREAM_INTERVAL_SECONDS=30

# Default map coverage: Poland and nearby airspace.
MAP_DEFAULT_LAMIN=49.0
MAP_DEFAULT_LAMAX=55.1
MAP_DEFAULT_LOMIN=14.0
MAP_DEFAULT_LOMAX=24.5

# Use '*' for local development or a specific frontend origin in production.
CORS_ALLOWED_ORIGIN=*
